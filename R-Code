# 3 & 4. MONTE CARLO: REPEAT THE FULL SAMPLING + ESTIMATION PROCEDURE
#        Keep point estimate, SE, lower and upper limits for each repetition
###############################################################################
R_reps <- 1000                                   # use 500 or 1000

pop_idx <- split(seq_len(N), as.character(diamond_finite$cut))
N_h_vec <- sapply(pop_idx, length)
n_h_vec <- setNames(strata$n_h, as.character(strata$cut))[names(pop_idx)]
n_total <- sum(n_h_vec)                          # equals n_str (1253)

pop_cut   <- as.character(diamond_finite$cut)
pop_price <- diamond_finite$price
pop_carat <- diamond_finite$carat

sim_one <- function() {
  # ---- Stratified: SRSWOR of n_h within each cut (Neyman allocation fixed) ----
  idx_s <- unlist(lapply(names(pop_idx), function(h)
    pop_idx[[h]][sample.int(N_h_vec[h], n_h_vec[h])]), use.names = FALSE)
  d_s <- data.frame(cut = pop_cut[idx_s], price = pop_price[idx_s],
                    carat = pop_carat[idx_s], stringsAsFactors = FALSE)
  d_s$N_h    <- unname(N_h_vec[d_s$cut])
  d_s$weight <- d_s$N_h / unname(n_h_vec[d_s$cut])
  des_s <- svydesign(ids = ~1, strata = ~cut, weights = ~weight,
                     fpc = ~N_h, data = d_s)
  
  # ---- SRSWOR benchmark of the same total size ----
  idx_r <- sample.int(N, n_total)
  d_r <- data.frame(price = pop_price[idx_r], carat = pop_carat[idx_r])
  d_r$weight <- N / n_total
  d_r$N      <- N
  des_r <- svydesign(ids = ~1, weights = ~weight, fpc = ~N, data = d_r)
  
  bind_rows(est_fun(des_s) %>% mutate(Design = "Stratified (Neyman)"),
            est_fun(des_r) %>% mutate(Design = "SRSWOR"))
}

set.seed(20031106)
sim_list <- vector("list", R_reps)
for (r in seq_len(R_reps)) {
  sim_list[[r]] <- suppressWarnings(sim_one()) %>% mutate(Rep = r)
  if (r %% 100 == 0) cat("Completed", r, "of", R_reps, "repetitions\n")
}
