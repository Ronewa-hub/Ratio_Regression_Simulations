  A <- k * A0;  B <- k^2 * B0
  data.frame(scale = k, n = n_grid, MoE = z * sqrt(A^2 / n_grid - B))
}))

# ---------- 2. Triangles: required n for the 5% target of each assumed value ----------
tri_df <- do.call(rbind, lapply(scales, function(k) {
  A <- k * A0;  B <- k^2 * B0
  target <- 0.05 * k * baseline
  n_req  <- ceiling(A^2 / ((target / z)^2 + B))
  data.frame(scale = k, n = n_req, target = target,
             MoE = z * sqrt(A^2 / n_req - B))
}))
