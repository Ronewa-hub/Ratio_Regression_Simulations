se_mean  <- as.numeric(SE(m0))

# ---------- 1. Ratio estimator ----------
r      <- svyratio(~price, ~carat, strat_design)      # R-hat = sum(w*y) / sum(w*x)
r_tot  <- predict(r, total = X_total)
est_R  <- as.numeric(r_tot$total) / N                 # y_R bar = R-hat * X_bar
se_R   <- as.numeric(r_tot$se) / N

# ---------- 2. Regression estimator with b_opt_hat = s_xy / s_x^2 ----------
w <- des_data$weight;  y <- des_data$price;  x <- des_data$carat

y_w   <- sum(w * y) / sum(w)                          # weighted mean of price
x_w   <- sum(w * x) / sum(w)                          # weighted mean of carat
s_xy  <- sum(w * (x - x_w) * (y - y_w)) / sum(w)      # weighted covariance
s_x2  <- sum(w * (x - x_w)^2) / sum(w)                # weighted variance of x
b_hat <- s_xy / s_x2                                  # b_opt_hat

est_reg <- y_w + b_hat * (X_bar - x_w)                # y_reg bar

# Variance: variance of the weighted mean of d_i = y_i - b_hat * x_i
m_d    <- svymean(~I(price - b_hat * carat), strat_design)
se_reg <- as.numeric(SE(m_d))

# Check against calibrate() (should match)
m_cal <- svymean(~price, calibrate(strat_design, ~carat,
                                   population = c("(Intercept)" = N, carat = X_total)))
c(by_hand = est_reg, calibrate = as.numeric(coef(m_cal)))
c(by_hand = se_reg,  calibrate = as.numeric(SE(m_cal)))

# ---------- 3. Reference variance for the design effect ----------
# SRSWOR sample mean of the same size n: V_SRS = (1 - n/N) * S^2 / n
S2_hat <- as.numeric(svyvar(~price, strat_design))    # design-based estimate of S^2
V_srs  <- (1 - n / N) * S2_hat / n

# ---------- 4. Results table ----------
target_hw <- 0.05 * baseline                          # 195.466

results <- data.frame(
  Method   = c("Sample mean", "Ratio", "Regression"),
  Estimate = c(est_mean, est_R, est_reg),
  SE       = c(se_mean,  se_R,  se_reg)
) %>%
  mutate(Variance    = SE^2,
         CI_Lower    = Estimate - z * SE,
         CI_Upper    = Estimate + z * SE,
         CV          = SE / Estimate,
         DEFF        = Variance / V_srs,
         HalfWidth   = z * SE,
         Within_5pct = HalfWidth <= target_hw) %>%
  select(Method, Estimate, Variance, SE, CI_Lower, CI_Upper,
         CV, DEFF, HalfWidth, Within_5pct)

print(results, digits = 5, row.names = FALSE)

# Optional: check the sample-mean DEFF against the survey package
