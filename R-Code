# ---------- Helper: three estimators of the mean for ANY survey design ----------
# (sample mean, ratio, regression via calibration on intercept + carat)
est_fun <- function(design) {
  m0 <- svymean(~price, design)
  
  r   <- svyratio(~price, ~carat, design)
  tot <- predict(r, total = X_total)
  
  cal <- calibrate(design, ~carat,
                   population = c("(Intercept)" = N, carat = X_total))
  m2  <- svymean(~price, cal)
  
  est <- c(as.numeric(coef(m0)), as.numeric(tot$total) / N, as.numeric(coef(m2)))
  se  <- c(as.numeric(SE(m0)),   as.numeric(tot$se) / N,    as.numeric(SE(m2)))
  
  data.frame(Method   = c("Sample mean", "Ratio", "Regression"),
             Estimate = est, SE = se,
             Lower    = est - z * se,
             Upper    = est + z * se,
             stringsAsFactors = FALSE)
}


