library(survey)

# Uses: srs_design, strat_design, N, X_total (from before)

get_est <- function(design, design_name) {
  
  # Baseline: weighted sample mean (no auxiliary variable)
  m0 <- svymean(~price, design)
  
  # Ratio estimator
  r   <- svyratio(~price, ~carat, design)
  tot <- predict(r, total = X_total)
  est_r <- as.numeric(tot$total) / N
  se_r  <- as.numeric(tot$se) / N
  
  # Regression estimator (calibration on intercept + carat)
  cal <- calibrate(design, ~carat,
                   population = c("(Intercept)" = N, carat = X_total))
  m2  <- svymean(~price, cal)
  
  data.frame(
    Design   = design_name,
    Method   = c("Sample mean", "Ratio", "Regression"),
    Estimate = c(as.numeric(coef(m0)), est_r, as.numeric(coef(m2))),
    SE       = c(as.numeric(SE(m0)),   se_r,  as.numeric(SE(m2)))
  )
}

res <- rbind(get_est(srs_design,   "SRSWOR"),
             get_est(strat_design, "Stratified"))

# Extra columns: SE relative to the sample mean and CI half-width vs the 5% target
res <- res %>%
  group_by(Design) %>%
  mutate(SE_vs_mean = SE / SE[Method == "Sample mean"]) %>%
  ungroup() %>%
  mutate(HalfWidth = 1.96 * SE,
         Within_5pct = HalfWidth <= 0.05 * 3909.325)

print(as.data.frame(res), digits = 5)

# Compact comparison table of SEs (rows = design, columns = method)
round(xtabs(SE ~ Design + Method, data = res), 2)

