                          data = SRSWOR_data)
strat_design <- svydesign(ids = ~1, strata = ~cut, weights = ~weight,
                          fpc = ~N_h, data = stratified_data)

# ---------- Ratio estimator ----------
ratio_mean <- function(design, label) {
  r   <- svyratio(~price, ~carat, design)      # R-hat and its SE
  tot <- predict(r, total = X_total)           # ratio estimate of the price total
  est <- as.numeric(tot$total) / N             # mean = total / N
  se  <- as.numeric(tot$se) / N
  cat("\n", label, "\n")
  print(r)                                     # ratio R-hat and SE
  data.frame(estimate = est, SE = se,
             lower = est - 1.96 * se, upper = est + 1.96 * se)
}

ratio_mean(srs_design,   "Ratio estimator, SRSWOR")
ratio_mean(strat_design, "Ratio estimator, Stratified")

# ---------- Regression estimator ----------
reg_mean <- function(design, label) {
  cal <- calibrate(design, ~carat,
                   population = c("(Intercept)" = N, carat = X_total))
  m   <- svymean(~price, cal)
  cat("\n", label, "\n")
  print(m)
  confint(m)
}

reg_mean(srs_design,   "Regression estimator, SRSWOR")
reg_mean(strat_design, "Regression estimator, Stratified")

