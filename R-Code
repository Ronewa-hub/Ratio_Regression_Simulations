################### Creating a new stratified dataset with relevant features.
library(dplyr)

set.seed(20031106)

# Give every diamond in the population a unique ID before sampling
pop   <- diamond_finite %>% mutate(pop_id = row_number())
alloc <- strata %>% select(cut, N_h, n_h)          # Neyman allocation from before

# ---------- Population within-stratum quantities (finite population) ----------
#   Ybar_h  = (1/N_h) * sum(y_hj)
#   S2_h    = 1/(N_h - 1) * sum( (y_hj - Ybar_h)^2 )   # S_i^2 in the notes
#   sigma2_h= 1/N_h       * sum( (y_hj - Ybar_h)^2 )   # sigma_i^2 in the notes
pop_var <- pop %>%
  group_by(cut) %>%
  summarise(Ybar_h   = mean(price),
            SS_h     = sum((price - mean(price))^2),
            S2_h     = SS_h / (n() - 1),
            sigma2_h = SS_h / n(),
            .groups  = "drop") %>%
  select(cut, S2_h, sigma2_h)

frame <- pop %>%
  left_join(alloc,   by = "cut") %>%
  left_join(pop_var, by = "cut")

# ---------- SRSWOR of n_h units within each cut (same draw as before) ----------
stratified_final <- do.call(rbind, lapply(
  split(frame, frame$cut),
  function(d) d[sample(nrow(d), d$n_h[1], replace = FALSE), ]))
rownames(stratified_final) <- NULL

# ---------- Sample within-stratum variance ----------
#   ybar_h = (1/n_h) * sum(y_hj)
#   s2_h   = 1/(n_h - 1) * sum( (y_hj - ybar_h)^2 )    # s_i^2 in the notes
stratified_final <- stratified_final %>%
  group_by(cut) %>%
  mutate(s2_h = sum((price - mean(price))^2) / (n() - 1)) %>%
  ungroup() %>%
  mutate(incl_prob = n_h / N_h,                    # inclusion probability
         weight    = 1 / incl_prob) %>%            # sampling weight
  select(unit_id       = pop_id,
         strata        = cut,
         N_h,                                      # stratum population size
         n_h,                                      # stratum sample size
         incl_prob, weight,
         S2_h_pop      = S2_h,                     # S_i^2     (divisor N_h - 1)
         sigma2_h_pop  = sigma2_h,                 # sigma_i^2 (divisor N_h)
         s2_h_samp     = s2_h,                     # s_i^2     (divisor n_h - 1)
         price, carat) %>%
  as.data.frame()

# ---------- Checks ----------
nrow(stratified_final)                        # 1253
n_distinct(stratified_final$unit_id)          # equals nrow, so IDs are unique
table(stratified_final$strata)                # matches n_h
all(stratified_final$incl_prob > 0)           # TRUE
sum(stratified_final$weight)                  # about 10000

# One row per stratum
strat_summary <- stratified_final %>%
  group_by(strata) %>%
  summarise(N_h = first(N_h), n_h = first(n_h), n_in_data = n(),
            S2_h_pop     = first(S2_h_pop),
            sigma2_h_pop = first(sigma2_h_pop),
            s2_h_samp    = first(s2_h_samp),
            weight       = first(weight), .groups = "drop")
