# Optional: slope and correlation behind the regression estimator
c(b_hat = b_hat, rho = s_xy / sqrt(s_x2 * sum(w * (y - y_w)^2) / sum(w)))

# Optional: save the table
write.csv(results, "stratified_estimates.csv", row.names = FALSE)

